<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- [PEP-PORTAAL-VELDEN] -->
    <record id="action_sync_portal_form_access" model="ir.actions.server">
        <field name="name">CLM: update portal access for /my/account</field>
        <field name="model_id" ref="base.model_ir_model_access"/>
        <field name="state">code</field>
        <field name="code">env["clm.portal.form.access"]._sync_portal_read_access()</field>
    </record>

    <!-- Loaded after the view, and re-run on every module update. Run the server action
         above after a Studio change that adds a relation to the portal form. -->
    <function model="clm.portal.form.access" name="_sync_portal_read_access"/>

</odoo>
